/* =========================================================
   BOOTSTRAP 5 THEME FOR PYSIDE6
   Replicates exact Bootstrap 5 colors, spacing, and borders
========================================================= */

/* GLOBAL TYPOGRAPHY & BODY (bs-body) */
QWidget {
    /* Bootstrap native font stack */
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    color: #212529; /* bs-body-color */
}

QMainWindow {
    background-color: #f8f9fa; /* bs-light background */
}

/* CARDS & FRAMES (bs-card) */
QFrame {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.125); /* Bootstrap card border */
    border-radius: 4px;
}

/* FORM INPUTS & DROPDOWNS (bs-form-control) */
QLineEdit, QComboBox {
    background-color: #ffffff;
    border: 1px solid #ced4da;
    border-radius: 4px;
    padding: 6px 12px;
    color: #212529;
    min-height: 24px;
}

/* Bootstrap Focus Ring */
QLineEdit:focus, QComboBox:focus {
    border: 1px solid #86b7fe;
    background-color: #ffffff;
}

/* DROPDOWN MENU LIST (bs-form-select menu) */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-radius: 4px;
    color: #212529;
    selection-background-color: #0d6efd; /* Bootstrap Primary Blue */
    selection-color: #ffffff;
    outline: none;
}

/* STANDARD BUTTONS (bs-btn bs-btn-primary) */
QPushButton {
    background-color: #0d6efd; /* Bootstrap Primary Blue */
    color: #ffffff;
    border: 1px solid #0d6efd;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #0b5ed7;
    border-color: #0a58ca;
}

QPushButton:disabled {
    background-color: #6ea8fe; /* Bootstrap Disabled Primary */
    border-color: #6ea8fe;
    color: #ffffff;
}

/* DATA TABLES (bs-table bs-table-striped) */
QTableView {
    background-color: #ffffff;
    alternate-background-color: #f2f2f2; /* Striped rows */
    border: 1px solid #dee2e6;
    border-radius: 4px;
    gridline-color: #dee2e6;
    selection-background-color: #0d6efd;
    selection-color: #ffffff;
    color: #212529;
}

QHeaderView::section {
    background-color: #ffffff;
    padding: 10px;
    border: none;
    border-right: 1px solid #dee2e6;
    border-bottom: 2px solid #212529; /* Bootstrap dark bottom border for table headers */
    font-weight: bold;
    color: #212529;
}

/* TABS (bs-nav bs-nav-tabs) */
QTabWidget::pane {
    border: 1px solid #dee2e6;
    background-color: #ffffff;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    border: 1px solid transparent;
    border-bottom: 1px solid #dee2e6;
    padding: 10px 16px;
    color: #0d6efd; /* Bootstrap Link Blue */
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover {
    border-color: #e9ecef #e9ecef #dee2e6;
    color: #0a58ca;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-color: #dee2e6 #dee2e6 #ffffff;
    color: #495057; /* Active tab dark text */
    font-weight: 500;
}

/* SCROLLBARS */
QScrollBar:vertical {
    border: none;
    background: #f8f9fa;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: #ced4da;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #adb5bd;
}

/* SCROLL AREA BACKGROUND FIX */
QScrollArea {
    background-color: #ffffff;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #ffffff;
}